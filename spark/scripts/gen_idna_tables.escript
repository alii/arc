#!/usr/bin/env escript
%% -*- erlang -*-
%%
%% Writes src/spark/spark_idna_tables.erl: what uts 46 needs to turn a domain
%% name into ascii, as plain Erlang literals.
%%
%% Input is a directory holding these files of one Unicode version, from
%% https://www.unicode.org/Public/<version>/idna/ and
%% https://www.unicode.org/Public/<version>/ucd/extracted/:
%%   IdnaMappingTable.txt  DerivedBidiClass.txt  DerivedJoiningType.txt
%%   DerivedGeneralCategory.txt  DerivedCombiningClass.txt
%%
%% Run from spark/:  escript scripts/gen_idna_tables.escript <directory>

-mode(compile).

main([Dir]) ->
    Mapping = merge([{Lo, Hi, status(Fields)} || {Lo, Hi, Fields} <- rows(Dir, "IdnaMappingTable.txt")]),
    Bidi = merge([{Lo, Hi, bidi(Class)} || {Lo, Hi, [Class | _]} <- rows(Dir, "DerivedBidiClass.txt"), Class =/= <<"L">>]),
    Joining = merge([{Lo, Hi, joining(Type)} || {Lo, Hi, [Type | _]} <- rows(Dir, "DerivedJoiningType.txt"), Type =/= <<"C">>]),
    Marks = merge([{Lo, Hi, m} || {Lo, Hi, [<<"M", _>> | _]} <- rows(Dir, "DerivedGeneralCategory.txt")]),
    Viramas = merge([{Lo, Hi, v} || {Lo, Hi, [<<"9">> | _]} <- rows(Dir, "DerivedCombiningClass.txt")]),
    Version = version(Dir),
    Out = [
        "%% GENERATED by scripts/gen_idna_tables.escript from the Unicode ", Version, "\n",
        "%% data files; do not edit.\n",
        "-module(spark_idna_tables).\n",
        "-export([mapping/0, bidi/0, joining/0, marks/0, viramas/0]).\n\n",
        "%% each a tuple of {First, Last, What} in code point order, for binary search\n\n",
        "%% What: v valid, x deviation, i ignored, d disallowed, or the code points\n",
        "%% it maps to\n",
        table("mapping", Mapping),
        "%% bidi class of everything that is not L\n",
        table("bidi", Bidi),
        "%% joining type: d, l, r or t\n",
        table("joining", Joining),
        "%% general category mark\n",
        table("marks", Marks),
        "%% canonical combining class virama\n",
        table("viramas", Viramas)
    ],
    ok = file:write_file("src/spark/spark_idna_tables.erl", Out),
    io:format("unicode ~s: mapping ~b, bidi ~b, joining ~b, marks ~b, viramas ~b ranges~n",
              [Version, length(Mapping), length(Bidi), length(Joining), length(Marks), length(Viramas)]).

version(Dir) ->
    {ok, Bin} = file:read_file(filename:join(Dir, "IdnaMappingTable.txt")),
    {match, [Version]} = re:run(Bin, "# Version: ([0-9.]+)", [{capture, [1], list}]),
    Version.

%% [{Lo, Hi, [Field]}] for every data line, fields trimmed, comments gone
rows(Dir, Name) ->
    {ok, Bin} = file:read_file(filename:join(Dir, Name)),
    lists:filtermap(fun row/1, binary:split(Bin, <<"\n">>, [global])).

row(Line) ->
    [Data | _] = binary:split(Line, <<"#">>),
    case [string:trim(F) || F <- binary:split(Data, <<";">>, [global])] of
        [<<>>] -> false;
        [Range | Fields] ->
            {Lo, Hi} = case binary:split(Range, <<"..">>) of
                [One] -> {hex(One), hex(One)};
                [A, B] -> {hex(A), hex(B)}
            end,
            {true, {Lo, Hi, Fields}}
    end.

hex(Bin) -> binary_to_integer(Bin, 16).

status([<<"valid">> | _]) -> v;
status([<<"deviation">> | _]) -> x;
status([<<"ignored">> | _]) -> i;
status([<<"disallowed">> | _]) -> d;
status([<<"mapped">>, To | _]) -> [hex(Cp) || Cp <- binary:split(To, <<" ">>, [global]), Cp =/= <<>>].

bidi(Class) -> binary_to_atom(string:lowercase(Class)).

joining(Type) -> binary_to_atom(string:lowercase(Type)).

%% neighbours with the same value become one range
merge(Rows) -> merge(lists:sort(Rows), []).

merge([{Lo, Hi, What}, {Next, Hi2, What} | Rest], Acc) when Next =:= Hi + 1 ->
    merge([{Lo, Hi2, What} | Rest], Acc);
merge([Row | Rest], Acc) -> merge(Rest, [Row | Acc]);
merge([], Acc) -> lists:reverse(Acc).

table(Name, Rows) ->
    [Name, "() ->\n    {", lists:join(",\n     ", [io_lib:format("~w", [Row]) || Row <- Rows]), "}.\n\n"].
